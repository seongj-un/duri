# ---------------------------------------------------------------------
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# ---------------------------------------------------------------------

# HS256 서명 키. 최소 32바이트. 생성: openssl rand -base64 48
JWT_SECRET=

# 계좌번호 암호화 키(AES-256). 32바이트 base64. 생성: openssl rand -base64 32
ACCOUNT_ENCRYPTION_KEY=

