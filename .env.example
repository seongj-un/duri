# ---------------------------------------------------------------------
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# ---------------------------------------------------------------------

# HS256 서명 키. 최소 32바이트. 생성: openssl rand -base64 48
JWT_SECRET=

# 계좌번호 암호화 키(AES-256). 32바이트 base64. 생성: openssl rand -base64 32
ACCOUNT_ENCRYPTION_KEY=

# https://developers.kakao.com  내 애플리케이션 > 앱 키 / 보안
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# https://console.cloud.google.com  API 및 서비스 > 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 성공 후 프론트로 돌려보낼 주소
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
